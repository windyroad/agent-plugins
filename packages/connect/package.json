{
  "name": "@windyroad/connect",
  "version": "0.3.10",
  "description": "Connect Claude Code sessions across repos via Discord (experimental)",
  "bin": {
    "windyroad-connect": "./bin/install.mjs"
  },
  "type": "module",
  "scripts": {
    "prepack": "node ../../scripts/sync-codex-plugin-surfaces.mjs connect --pack",
    "postpack": "node ../../scripts/sync-codex-plugin-surfaces.mjs connect --restore-pack"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/windyroad/agent-plugins.git",
    "directory": "packages/connect"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "codex",
    "ai-agent",
    "ai-coding",
    "cross-repo",
    "discord",
    "collaboration"
  ],
  "files": [
    "bin/",
    "hooks/",
    "skills/",
    "hooks-codex/",
    ".agents/",
    ".claude-plugin/",
    ".codex-plugin/",
    "lib/",
    "!hooks/test/"
  ]
}
