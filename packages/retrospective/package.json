{
  "name": "@windyroad/retrospective",
  "version": "0.28.1",
  "description": "Session retrospectives that update briefings and create problem tickets",
  "bin": {
    "windyroad-retrospective": "./bin/install.mjs"
  },
  "type": "module",
  "scripts": {
    "prepack": "node ../../scripts/sync-codex-plugin-surfaces.mjs retrospective --pack",
    "postpack": "node ../../scripts/sync-codex-plugin-surfaces.mjs retrospective --restore-pack"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/windyroad/agent-plugins.git",
    "directory": "packages/retrospective"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "codex",
    "ai-agent",
    "ai-coding"
  ],
  "files": [
    "bin/",
    "agents/",
    "hooks/",
    "skills/",
    "hooks-codex/",
    "scripts/",
    ".claude-plugin/",
    ".agents/",
    ".codex-plugin/",
    "lib/",
    "!skills/*/eval/",
    "!hooks/test/",
    "!scripts/test/",
    "!skills/*/test/"
  ]
}
