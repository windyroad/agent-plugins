    "claude-code",
    "claude-code-plugin",
    "codex",
    "ai-agent",
    "ai-coding"
  ],
  "files": [
    "bin/",
    "agents/",
    "hooks/",
    "skills/",
    "hooks-codex/",
    ".agents/",
    ".claude-plugin/",
    ".codex-plugin/",
    "lib/",
