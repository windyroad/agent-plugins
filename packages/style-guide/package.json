  "description": "Style guide enforcement for CSS and UI components",
  "bin": {
    "windyroad-style-guide": "./bin/install.mjs"
  },
  "type": "module",
  "scripts": {
    "prepack": "node ../../scripts/sync-codex-plugin-surfaces.mjs style-guide --pack",
