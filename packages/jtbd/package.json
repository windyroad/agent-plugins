{
  "name": "@windyroad/jtbd",
  "version": "0.14.1",
  "description": "Jobs-to-be-done enforcement for UI changes",
  "bin": {
    "windyroad-jtbd": "./bin/install.mjs"
  },
  "type": "module",
  "scripts": {
    "prepack": "node ../../scripts/sync-codex-plugin-surfaces.mjs jtbd --pack",
    "postpack": "node ../../scripts/sync-codex-plugin-surfaces.mjs jtbd --restore-pack"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/windyroad/agent-plugins.git",
    "directory": "packages/jtbd"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "codex",
    "ai-agent",
    "ai-coding"
  ],
  "files": [
    "bin/",
    "agents/",
    "hooks/",
    "skills/",
    "hooks-codex/",
    "scripts/",
    ".claude-plugin/",
    ".agents/",
    ".codex-plugin/",
    "lib/",
    "!skills/*/eval/",
    "!agents/eval/",
    "!agents/test/",
    "!hooks/test/",
    "!scripts/test/"
  ]
}
