#!/usr/bin/env bats

setup() {
  REPO_ROOT="$(cd "$(dirname "$BATS_TEST_FILENAME")/../../../.." && pwd)"
  TMP="$(mktemp -d)"
}

teardown() {
  rm -rf "$TMP"
}

@test "standalone tarball installs Codex skill without ITIL and preserves personal skill on update/uninstall" {
  run npm pack "$REPO_ROOT/packages/planning" --pack-destination "$TMP"
  [ "$status" -eq 0 ]
  mkdir "$TMP/extracted" "$TMP/bin"
  tar -xzf "$TMP"/*.tgz -C "$TMP/extracted"
  export CODEX_HOME="$TMP/home"
  mkdir -p "$CODEX_HOME/skills/outcome-led-planning/agents"
  printf 'personal skill sentinel\n' > "$CODEX_HOME/skills/outcome-led-planning/SKILL.md"
  printf 'personal metadata sentinel\n' > "$CODEX_HOME/skills/outcome-led-planning/agents/openai.yaml"
  cat > "$TMP/bin/codex" <<'SH'
#!/usr/bin/env bash
if [ "${1:-}" = "--version" ]; then echo codex-test; exit 0; fi
printf '%s\n' "$*" >> "$CODEX_HOME/calls"
SH
  chmod +x "$TMP/bin/codex"
  for operation in install update uninstall; do
    local args=()
    [ "$operation" = install ] || args+=("--$operation")
    run env PATH="$TMP/bin:$PATH" node "$TMP/extracted/package/bin/install.mjs" --runtime codex --scope user "${args[@]}"
    [ "$status" -eq 0 ]
    [ "$(cat "$CODEX_HOME/skills/outcome-led-planning/SKILL.md")" = 'personal skill sentinel' ]
    [ "$(cat "$CODEX_HOME/skills/outcome-led-planning/agents/openai.yaml")" = 'personal metadata sentinel' ]
  done
  run node - "$TMP/extracted/package" <<'NODE'
const fs = require('node:fs');
const path = require('node:path');
const assert = require('node:assert/strict');
const root = process.argv[2];
const manifest = JSON.parse(fs.readFileSync(path.join(root, '.codex-plugin/plugin.json')));
assert.equal(manifest.name, 'wr-planning');
assert.ok(fs.existsSync(path.join(root, manifest.skills, 'outcome-led-planning/SKILL.md')));
assert.ok(fs.existsSync(path.join(root, manifest.skills, 'outcome-led-planning/agents/openai.yaml')));
const reference = 'outcome-led-planning/references/github-coordination.md';
assert.ok(fs.readFileSync(path.join(root, manifest.skills, reference), 'utf8').length > 0);
assert.deepEqual(fs.readFileSync(path.join(root, manifest.skills, reference)), fs.readFileSync(path.join(root, 'skills', reference)));
for (const absent of ['hooks', 'hooks-codex', 'agents', 'templates']) assert.equal(fs.existsSync(path.join(root, absent)), false, absent);
assert.equal(manifest.hooks, undefined);
NODE
  [ "$status" -eq 0 ]
  [ "$(grep -c '^plugin add wr-planning@windyroad-planning-local$' "$CODEX_HOME/calls")" -eq 2 ]
  [ "$(grep -c '^plugin remove wr-planning@windyroad-planning-local$' "$CODEX_HOME/calls")" -eq 1 ]
  [ "$(grep -c '^plugin marketplace remove windyroad-planning-local$' "$CODEX_HOME/calls")" -eq 1 ]
  ! grep -q 'itil' "$CODEX_HOME/calls"
}

@test "standalone Claude installer selects only planning" {
  run node "$REPO_ROOT/packages/planning/bin/install.mjs" --dry-run --runtime claude
  [ "$status" -eq 0 ]
  [[ "$output" == *'claude plugin install wr-planning@windyroad'* ]]
  [[ "$output" != *'wr-itil'* ]]
  [[ "$output" != *'Warning'* ]]
}

@test "suite installer accepts planning as an independent selection" {
  run node "$REPO_ROOT/packages/agent-plugins/bin/install.mjs" --dry-run --plugin planning
  [ "$status" -eq 0 ]
  [[ "$output" == *'claude plugin install wr-planning@windyroad'* ]]
  [[ "$output" != *'claude plugin install wr-itil'* ]]
}

@test "compatibility synchronizer detects drift and restores complete standalone ITIL body" {
  mkdir -p "$TMP/scripts" "$TMP/packages/planning/skills/outcome-led-planning" "$TMP/packages/itil/skills/outcome-led-planning"
  cp "$REPO_ROOT/scripts/sync-planning-skill.mjs" "$TMP/scripts/"
  printf '%s\n' '---' 'name: outcome-led-planning' 'description: Plan.' '---' 'Complete independently usable workflow.' > "$TMP/packages/planning/skills/outcome-led-planning/SKILL.md"
  printf 'stale\n' > "$TMP/packages/itil/skills/outcome-led-planning/SKILL.md"
  mkdir -p "$TMP/packages/planning/skills/outcome-led-planning/references"
  printf 'Independent shared protocol fixture.\n' > "$TMP/packages/planning/skills/outcome-led-planning/references/github-coordination.md"
  run node "$TMP/scripts/sync-planning-skill.mjs" --check
  [ "$status" -ne 0 ]
  run node "$TMP/scripts/sync-planning-skill.mjs"
  [ "$status" -eq 0 ]
  run node "$TMP/scripts/sync-planning-skill.mjs" --check
  [ "$status" -eq 0 ]
  printf '%s\n' '---' '# Generated by scripts/sync-planning-skill.mjs; edit packages/planning instead.' 'name: wr-itil:outcome-led-planning' 'description: Plan.' '---' 'Complete independently usable workflow.' > "$TMP/expected"
  cmp "$TMP/expected" "$TMP/packages/itil/skills/outcome-led-planning/SKILL.md"
  cmp "$TMP/packages/planning/skills/outcome-led-planning/references/github-coordination.md" "$TMP/packages/itil/skills/outcome-led-planning/references/github-coordination.md"
  printf 'stale protocol\n' > "$TMP/packages/itil/skills/outcome-led-planning/references/github-coordination.md"
  run node "$TMP/scripts/sync-planning-skill.mjs" --check
  [ "$status" -ne 0 ]
  run node "$TMP/scripts/sync-planning-skill.mjs"
  [ "$status" -eq 0 ]
  cmp "$TMP/expected" "$TMP/packages/itil/skills/outcome-led-planning/SKILL.md"
  cmp "$TMP/packages/planning/skills/outcome-led-planning/references/github-coordination.md" "$TMP/packages/itil/skills/outcome-led-planning/references/github-coordination.md"
  rm "$TMP/packages/itil/skills/outcome-led-planning/references/github-coordination.md"
  run node "$TMP/scripts/sync-planning-skill.mjs" --check
  [ "$status" -ne 0 ]
  run node "$TMP/scripts/sync-planning-skill.mjs"
  [ "$status" -eq 0 ]
  run node "$REPO_ROOT/scripts/sync-planning-skill.mjs" --check
  [ "$status" -eq 0 ]
}
