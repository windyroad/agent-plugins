{
  "name": "@windyroad/tdd",
  "version": "0.6.1",
  "description": "TDD state machine enforcement (Red-Green-Refactor cycle)",
  "bin": {
    "windyroad-tdd": "./bin/install.mjs"
  },
  "type": "module",
  "scripts": {
    "prepack": "node ../../scripts/sync-codex-plugin-surfaces.mjs tdd --pack",
    "postpack": "node ../../scripts/sync-codex-plugin-surfaces.mjs tdd --restore-pack"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/windyroad/agent-plugins.git",
    "directory": "packages/tdd"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "codex",
    "ai-agent",
    "ai-coding"
  ],
  "files": [
    "bin/",
    "agents/",
    "hooks/",
    "skills/",
    "hooks-codex/",
    ".agents/",
    ".claude-plugin/",
    ".codex-plugin/",
    "lib/",
    "!agents/eval/",
    "!agents/test/",
    "!hooks/test/"
  ]
}
